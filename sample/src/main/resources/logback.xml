<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="UI" class="tr.com.onurbaykal.loglevelmanager.sample.UiLogAppender"/>

    <logger name="tr.com.onurbaykal.loglevelmanager.sample.billing" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="UI"/>
    </root>
</configuration>
